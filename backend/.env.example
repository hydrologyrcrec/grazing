# Copy to .env; never commit the populated file.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://grazing:SET_A_LOCAL_DATABASE_PASSWORD@localhost:5432/grazing
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=grazing-web
AUTH_JWT_AUDIENCE=grazing-web
ALLOWED_ORIGINS=["http://localhost:4200"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Replace with an actual operator contact before using address search.
GEOCODER_USER_AGENT=
