generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PastureStatus {
  ACTIVE
  ARCHIVED
}

enum LandUse {
  GRAZING
  HAY
  MIXED
  OTHER
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @db.VarChar(255)
  firstName       String?    @db.VarChar(100)
  lastName        String?    @db.VarChar(100)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  lastLoginAt     DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  pasturesCreated Pasture[] @relation("PastureCreator")

  @@index([status])
}

model Pasture {
  id                String        @id @default(uuid()) @db.Uuid
  createdById       String        @db.Uuid
  name              String        @db.VarChar(255)
  description       String?       @db.Text
  status            PastureStatus @default(ACTIVE)
  landUse           LandUse       @default(GRAZING)
  grassType         String        @db.VarChar(150)
  color             String        @default("#28A8CF") @db.Char(7)

  // GeoJSON Polygon using [longitude, latitude] coordinate pairs.
  boundary          Json          @db.JsonB

  // Cached geographic values for centering and fitting the map.
  centroidLat       Decimal       @db.Decimal(9, 6)
  centroidLng       Decimal       @db.Decimal(9, 6)
  boundingNorth     Decimal       @db.Decimal(9, 6)
  boundingSouth     Decimal       @db.Decimal(9, 6)
  boundingEast      Decimal       @db.Decimal(9, 6)
  boundingWest      Decimal       @db.Decimal(9, 6)

  areaAcres          Decimal @db.Decimal(12, 4)
  grazeableAreaAcres Decimal @db.Decimal(12, 4)

  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)

  createdBy User @relation("PastureCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([createdById, name])
  @@index([createdById, status])
  @@index([createdById, updatedAt])
}